# Copy to .env.local for local use; .env.example is not loaded by Vite.
# Set both variables in your hosting environment before building for deployment.
# Use the backend origin without /api. Leave empty locally to use the Vite /api proxy.
VITE_API_URL=https://full-stack-stock-trading-platform-js09.onrender.com
# Required for builds: your deployed dashboard URL (without /login).
# Leave empty during local development to use port 5174 on the current hostname.
VITE_DASHBOARD_URL=https://full-stack-stock-trading-platform-five.vercel.app
