# Copy to .env.local for local use; .env.example is not loaded by Vite.
# VITE_API_URL is required in your hosting environment before building.
# Use the backend origin without /api. Leave empty locally to use the Vite /api proxy.
VITE_API_URL=https://full-stack-stock-trading-platform-js09.onrender.com
# Optional until the frontend is deployed: its URL (without /login).
# When empty in production, login redirects are disabled.
# Leave empty during local development to use port 5173 on the current hostname.
VITE_FRONTEND_URL=
